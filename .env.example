# Copy to .env and fill in. Never commit .env.

# Required in production
NODE_ENV=production
JWT_SECRET=replace-with-at-least-32-random-characters
# First deploy only: creates the first admin when the database is empty (password 12+ chars)
ADMIN_EMAIL=admin@yourschool.example
ADMIN_PASSWORD=replace-with-a-long-passphrase

# Storage (inside the container these are set by the Dockerfile)
DB_PATH=/data/nitex.db

# Networking
PORT=4000
# Set to 1 when behind a reverse proxy (Nginx, Caddy, a load balancer), so rate limits see real client IPs
TRUST_PROXY=1
# Comma-separated origins allowed to call the API from a browser. Leave empty: the web app is same-origin.
CORS_ORIGINS=

# Optional
# Demo accounts are off in production. Never enable this for a real school.
SEED_DEMO=false
ATTENDANCE_EDIT_WINDOW_DAYS=7

# Phase 0: where uploaded files live (default: server/src/uploads). Keep backups off the app disk.
# UPLOADS_DIR=/var/lib/nitex/uploads
# BACKUP_DIR=/var/backups/nitex
# BACKUP_KEEP=14

# Phase 2: parent messages. Each provider stays in "none" (holds messages) until you choose one.
# In development the default is "log" (nothing is sent). MESSAGING_WORKER=off stops the background sender.
# MESSAGING_EMAIL_PROVIDER=smtp
# MESSAGING_SMS_PROVIDER=none
# MESSAGING_WHATSAPP_PROVIDER=none
# MESSAGING_RETENTION_DAYS=365
# MESSAGING_WORKER=on

# Phase 2 and 3: email through the Google Workspace SMTP relay (one App Password for the sender account).
# Never commit the password. Test it with: cd server && npm run smtp:check -- you@example.com
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
# SMTP_FROM=notifications@ranidevi.edu.np
# SMTP_USER=notifications@ranidevi.edu.np
# SMTP_PASS=replace-with-16-character-app-password

# Phase 3: fees. Khalti stays off (online payment returns 503) until KHALTI_SECRET_KEY is set.
# Use sandbox keys first. KHALTI_ENV is "sandbox" (default) or "production".
# KHALTI_SECRET_KEY=
# KHALTI_ENV=sandbox
# PUBLIC_BASE_URL=https://your-school-domain.example
# Concession above this many paisa needs the Finance Manager (default 500000 = NPR 5,000). Confirmed 2026-10-12;
# compared with the concession amount, not the invoice total.
# FEES_CONCESSION_HIGH_PAISA=500000
# Reconciliation escalation tiers, in paisa (1000000 = NPR 10,000; 5000000 = NPR 50,000). The high tier must be larger.
# FEES_TIER_SUPERVISOR_PAISA=1000000
# FEES_TIER_HEAD_PAISA=5000000
# Comma-separated recipient lists for the daily reconciliation report (set them to Google Groups on the school domain).
# FEES_FINANCE_EMAILS=finance.ops@ranidevi.edu.np
# FEES_OPS_EMAILS=operations@ranidevi.edu.np
# FEES_SUPERVISOR_EMAILS=finance.supervisor@ranidevi.edu.np
# FEES_HEAD_FINANCE_EMAILS=head.finance@ranidevi.edu.np
# Daily sign-off digest (totals and a link to the sign-off screen). Needs PUBLIC_BASE_URL to be https for the link.
# FEES_SIGNOFF_EMAILS=finance.ops@ranidevi.edu.np,head.finance@ranidevi.edu.np
# Days without movement before unapplied credit is refunded automatically (default 90).
# FEES_CREDIT_AUTO_REFUND_DAYS=90
# Set to off to stop the scheduled daily reconciliation job.
# FEES_DAILY_JOB=on
