# Copy to .env and fill in. Never commit .env.

# Required in production
NODE_ENV=production
JWT_SECRET=replace-with-at-least-32-random-characters
# First deploy only: creates the first admin when the database is empty (password 12+ chars)
ADMIN_EMAIL=admin@yourschool.example
ADMIN_PASSWORD=replace-with-a-long-passphrase

# Storage (inside the container these are set by the Dockerfile)
DB_PATH=/data/nitex.db

# Networking
PORT=4000
# Set to 1 when behind a reverse proxy (Nginx, Caddy, a load balancer), so rate limits see real client IPs
TRUST_PROXY=1
# Comma-separated origins allowed to call the API from a browser. Leave empty: the web app is same-origin.
CORS_ORIGINS=

# Optional
# Demo accounts are off in production. Never enable this for a real school.
SEED_DEMO=false
ATTENDANCE_EDIT_WINDOW_DAYS=7
